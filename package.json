{
  "name": "ibkr-usd-lens",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Private, display-only KRW to USD annotations for IBKR Positions.",
  "engines": {
    "node": ">=22.12.0 <23 || >=24"
  },
  "scripts": {
    "icons": "node scripts/render-icons.mjs",
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "npm run build && npm run build:test && playwright test",
    "check": "npm run typecheck && npm test && npm run test:browser",
    "demo": "npm run build:test && node scripts/demo-server.mjs",
    "smoke:fx": "npm run build && node scripts/smoke-fx.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.4",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
